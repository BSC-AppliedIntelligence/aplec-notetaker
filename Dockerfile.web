# The web app as a container (docs/INSTALL.md, section 9). The worker needs the
# GPU and runs natively or from Dockerfile.worker; the web app needs neither.
#
# The app reads /app/.env.worker and keeps its data in /app/data: mount both
# there, and keep the paths in .env.worker relative (the defaults), so they resolve
# the same way inside the container as on the host. Only the worker modules the
# web app imports ride along (stdlib, itsdangerous and pydantic; no torch).
#
# Build:  docker build -t aplec-notetaker-web -f Dockerfile.web .
FROM python:3.12-slim

WORKDIR /app

COPY requirements.web.txt .
RUN pip install --no-cache-dir -r requirements.web.txt

COPY aplec_web/ aplec_web/
COPY aplec_worker/__init__.py aplec_worker/user_prefs.py \
     aplec_worker/capture.py aplec_worker/users.py \
     aplec_worker/meeting_chat.py aplec_worker/schemas.py \
     aplec_worker/speaker_merge.py aplec_worker/meeting_access.py \
     aplec_worker/

# A reverse proxy in front reaches the container over its network; binding
# beyond loopback also turns off the loopback-only dev login.
ENV APLEC_WEB_HOST=0.0.0.0
EXPOSE 18091

CMD ["uvicorn", "aplec_web.app:app", "--host", "0.0.0.0", "--port", "18091", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
