--- /dev/null
+++ b/services/vexa-bot/core/src/cdp-cookies.ts
index 00000000..bb8c1bfd
--- /dev/null
+++ b/services/vexa-bot/core/src/cdp-cookies.ts
@@ -0,0 +1,48 @@
+// fred-live patch: CDP cookie export/import to persist Google's *session* cookies.
+//
+// Chromium only writes cookies that carry an explicit expiry to the on-disk
+// Default/Cookies SQLite file. Google's login (SID/SSID/HSID/SAPISID/__Secure-*PSID
+// etc.) uses in-memory session cookies with no expiry, so the S3/profile save loses
+// the actual login — the authenticated bot then hits Google's ?pli= interstitial and
+// never sees "Join now". Upstream documents this in BROWSER-SESSION.md but ships no fix.
+//
+// Fix: before each save, dump the full cookie jar (session cookies included) via the
+// Playwright/CDP cookie API to Default/cdp-cookies.json (which IS in the persisted
+// profile); on the authenticated meeting join, re-inject them with addCookies before
+// navigating to the meeting.
+import * as fs from 'fs';
+import * as path from 'path';
+import type { BrowserContext } from 'playwright';
+import { BROWSER_DATA_DIR } from './browser-profile';
+
+const COOKIE_FILE = path.join(BROWSER_DATA_DIR, 'Default', 'cdp-cookies.json');
+
+export async function exportCdpCookies(context: BrowserContext): Promise<number> {
+  const cookies = await context.cookies();
+  fs.mkdirSync(path.dirname(COOKIE_FILE), { recursive: true });
+  fs.writeFileSync(COOKIE_FILE, JSON.stringify(cookies), 'utf-8');
+  return cookies.length;
+}
+
+export async function importCdpCookies(context: BrowserContext): Promise<number> {
+  if (!fs.existsSync(COOKIE_FILE)) return 0;
+  let cookies: any[];
+  try {
+    cookies = JSON.parse(fs.readFileSync(COOKIE_FILE, 'utf-8'));
+  } catch {
+    return 0;
+  }
+  if (!Array.isArray(cookies) || cookies.length === 0) return 0;
+  // addCookies rejects the whole batch on one malformed entry; add individually so a
+  // single stale cookie can't wipe the login session.
+  let restored = 0;
+  for (const c of cookies) {
+    try {
+      await context.addCookies([c]);
+      restored++;
+    } catch {
+      /* skip individual bad cookie */
+    }
+  }
+  return restored;
+}
