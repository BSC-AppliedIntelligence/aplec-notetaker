{
  "manifest_version": 3,
  "name": "Aplec: meeting notes without the bot",
  "version": "0.4.0",
  "description": "Records Meet, Teams and Zoom calls in your browser and sends them to your team's self-hosted Aplec for notes with speaker names.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "notifications",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/*",
    "http://localhost:18088/*",
    "http://127.0.0.1:18088/*",
    "http://localhost:18091/*",
    "https://aplec.example.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Aplec: click to record this meeting"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/aplec16.png",
    "48": "icons/aplec48.png",
    "128": "icons/aplec128.png"
  }
}