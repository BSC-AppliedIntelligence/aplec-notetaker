# fred-live worker + web configuration.
# Copy to .env.worker and fill in the secrets. Path settings default to
# locations inside this checkout (fred_live_worker/config.py), so they are
# commented out below; set them only to point somewhere else.

# --- worker HTTP surface (scripts/run_worker.sh) ---
FRED_LIVE_APP_HOST=0.0.0.0
# The web app (FRED_LIVE_WORKER_URL) and the meeting bot's webhook expect 18088.
# scripts/run_worker.sh reads it from its environment; the example unit in
# deploy/systemd loads this file.
FRED_LIVE_APP_PORT=18088

#FRED_LIVE_DATA_DIR=<checkout>/data
#FRED_LIVE_RECORDINGS_DIR=<checkout>/recordings

# --- ASR ---
# Backend: "whispercpp" (default; GGML, ~4GB, seconds per meeting) or
# "transformers" (HF pipeline, needed only for .bin-only fine-tunes).
FRED_LIVE_ASR_BACKEND=whispercpp
# whispercpp backend paths (used when ASR_BACKEND=whispercpp):
#FRED_LIVE_WHISPERCPP_BIN=<checkout>/vendor/whisper.cpp/build/bin/whisper-cli
#FRED_LIVE_WHISPERCPP_MODEL=<checkout>/models/ggml-whisper/ggml-large-v3.bin
# whisper-batch (scripts/build_whisper_batch.sh) keeps the model loaded for a
# meeting's span calls: same text as whisper-cli, ~2-3x faster ASR. Looked for
# next to WHISPERCPP_BIN; without it every call runs whisper-cli as before.
#FRED_LIVE_ASR_WHISPERCPP_BATCH=true
#FRED_LIVE_WHISPERCPP_BATCH_BIN=<checkout>/vendor/whisper.cpp/build/bin/whisper-batch
# transformers backend checkpoint dir (used ONLY when ASR_BACKEND=transformers;
# ignored by the default whispercpp backend).
#FRED_LIVE_ASR_MODEL_DIR=<checkout>/models/openai__whisper-large-v3
FRED_LIVE_ASR_LANGUAGE=auto
FRED_LIVE_ASR_CHUNK_LENGTH_S=30
FRED_LIVE_ASR_BATCH_SIZE=8
# Multilingual (code-switch) pipeline. Disable only for guaranteed-monolingual audio.
FRED_LIVE_ASR_MULTILINGUAL=true
# Anti-hallucination: retry loops with temperature; skip near-silent spans.
FRED_LIVE_ASR_LOOP_RETRY=true
FRED_LIVE_ASR_MIN_SPAN_SPEECH_SECONDS=0.3
# That gate's threshold sits this many dB below the recording's loud speech,
# never above the fixed 0.01 RMS (0 = always the fixed one).
FRED_LIVE_ASR_SPAN_GATE_RELATIVE_DB=30

# Automatic sharing: each meeting is shared, read only, with the registered
# users recognized BY VOICE in it (each owner can turn it off in Settings).
# Stricter than naming a speaker: minimum voice score and seconds of speech.
#FRED_LIVE_AUTO_SHARE=true
#FRED_LIVE_AUTO_SHARE_MIN_SCORE=0.60
#FRED_LIVE_AUTO_SHARE_MIN_SECONDS=10

# Speaker diarization (pyannote/speaker-diarization-community-1; gated on HF).
FRED_LIVE_DIARIZATION_ENABLED=true
# Skip the speaker embeddings of speakers silent for a whole 10 s chunk (a
# constant vector; ~45% of the diarization time). Same turns either way.
#FRED_LIVE_DIARIZATION_SKIP_SILENT=true
# Second diarizer, off by default: who speaks comes from Nemotron 3 Diarization
# and the speech it missed from pyannote. Needs scripts/setup_nemotron.sh.
#FRED_LIVE_DIARIZATION_NEMOTRON=false
#FRED_LIVE_NEMOTRON_THRESHOLD=0.35
# HF token for the gated model. FRED_LIVE_HF_TOKEN is what the worker reads;
# the bare HF_TOKEN below is what huggingface_hub reads. Keep them equal.
# Either may be empty if a cached `huggingface-cli login` exists for an
# account that accepted the gate.
FRED_LIVE_HF_TOKEN=
HF_TOKEN=

# --- language ID (short-span rescoring) ---
# Intra-block language-switch detection (same speaker changing language
# mid-monologue): blocks >= MIN_BLOCK are split at pauses >= MIN_PAUSE into
# chunks >= MIN_CHUNK, each language-ID'd, same-language neighbors re-merged.
FRED_LIVE_ASR_LID_SPLIT=true
FRED_LIVE_ASR_LID_MIN_BLOCK_SECONDS=8
FRED_LIVE_ASR_LID_MIN_PAUSE_SECONDS=0.6
FRED_LIVE_ASR_LID_MIN_CHUNK_SECONDS=3
# Short-span rescoring: Whisper's language detection is near chance on sub-8s
# chunks. A language enters the meeting's inventory by cumulative >= EVIDENCE
# seconds of Whisper-detected duration (spans >= 4s); shorter off-inventory
# spans are repaired by ECAPA/VoxLingua107 constrained to that inventory.
FRED_LIVE_LID_RESCORE=true
FRED_LIVE_ASR_LANG_EVIDENCE_SECONDS=8
#FRED_LIVE_LID_MODEL_DIR=<checkout>/models/speechbrain__lang-id-voxlingua107-ecapa
# Second language tag in Whisper's prompt. Spans outside the meeting's main
# language get the main one too; spans in the main language get the second
# language only if it holds at least MIN_SHARE of the speech. Needs whisper-batch
# built by scripts/build_whisper_batch.sh, which applies the whisper.cpp patch.
FRED_LIVE_ASR_SECOND_LANGUAGE=true
FRED_LIVE_ASR_SECOND_LANGUAGE_MIN_SHARE=0.10
# A language that only reached the inventory by summing 4-8 s spans must also be heard
# by ECAPA; if not (an accent read as Portuguese, English from short spans), its spans
# are decoded with the main language first and labeled with it.
FRED_LIVE_ASR_CONFIRM_CUMULATIVE_LANGUAGES=true
# A language a long span let in that ECAPA does not hear either (one span of Spanish
# read as Welsh, but also real English with an accent) stays the language of whoever
# spoke it at length; the other speakers' short spans read in it are decoded with
# their own language first.
FRED_LIVE_ASR_SPEAKER_LANGUAGES=true
# Genuine off-inventory aside survives only when Whisper AND ECAPA agree:
# ECAPA >= MIN_PROB on a span >= MIN_SECONDS.
FRED_LIVE_LID_ESCAPE_MIN_PROB=0.85
FRED_LIVE_LID_ESCAPE_MIN_SECONDS=3

# --- known-speaker identification (voiceprints) ---
# Enroll team members: python -m fred_live_worker.enroll --name "X" a.wav b.m4a
# No-op until someone is enrolled. Voice votes fill clusters DOM cannot see,
# re-unite oversplit ones, and (OVERRIDE_DOM below) replace conflicting DOM
# names when they pass the gates.
FRED_LIVE_VOICEPRINTS_ENABLED=true
# "auto" = ReDimNet2 via wespeaker when installed, else speechbrain ECAPA.
FRED_LIVE_VOICEPRINT_BACKEND=auto
FRED_LIVE_VOICEPRINT_MODEL_DIR=
FRED_LIVE_VOICEPRINT_THRESHOLD=0.55
FRED_LIVE_VOICEPRINT_MARGIN=0.08
# The team's own names, one per line: term | what it is | how it comes out wrong
#FRED_LIVE_GLOSSARY_FILE=data/glossary.txt
#FRED_LIVE_PAGE_VOICES=true
#FRED_LIVE_VOICE_SWEEP=true
#FRED_LIVE_AUDIO_CHANNELS=true
# A gate-passing voice match REPLACES a conflicting DOM name (hybrid rooms:
# every room voice arrives through the mic owner's Meet identity).
FRED_LIVE_VOICEPRINT_OVERRIDE_DOM=true

# --- summarizer LLM (worker-side client) ---
# Any OpenAI-compatible API: llama.cpp/vLLM (base with or without /v1), an Open
# WebUI instance (base ending in /api), or a hosted API (its .../v1 base, or the
# full .../chat/completions URL; also set FRED_LIVE_LLM_DISABLE_THINKING=false and
# FRED_LIVE_LLM_CTX_SIZE to the model's window). See docs/INSTALL.md, section 5.
#   FRED_LIVE_LLM_BASE_URL=https://api.openai.com/v1
#   FRED_LIVE_LLM_MODEL=<the model's name>
#   FRED_LIVE_LLM_API_KEY=<an API key>
FRED_LIVE_LLM_BASE_URL=http://127.0.0.1:18081
# Model alias the llama server was started with (scripts/run_llama_server.sh).
FRED_LIVE_LLM_MODEL=qwen3.8-27b
# Informational only: the model actually served is set in scripts/run_llama_server.sh.
#FRED_LIVE_LLM_GGUF_PATH=<checkout>/models/unsloth__Qwen3.8-27B-GGUF/Qwen3.8-27B-UD-Q6_K.gguf
# Bearer key for the LLM server: must match the key file the llama server loads
# (FRED_LIVE_LLAMACPP_API_KEY_FILE below). Empty for a loopback server without a key.
FRED_LIVE_LLM_API_KEY=
FRED_LIVE_LLM_TIMEOUT_SECONDS=600
FRED_LIVE_LLM_TEMPERATURE=0.1
FRED_LIVE_LLM_MAX_TOKENS=4096
# Worker-side context budget PER REQUEST; keep equal to the llama server's
# per-slot context (FRED_LIVE_LLAMACPP_CTX_SIZE / FRED_LIVE_LLAMACPP_PARALLEL).
# Transcripts that don't fit trigger map-reduce summarization automatically.
FRED_LIVE_LLM_CTX_SIZE=65536
FRED_LIVE_LLM_OUTPUT_LANGUAGE=same-as-transcript
# Notes in two steps: decisions and tasks listed part by part (~12k characters of
# transcript each), then the notes written from the transcript and that list.
FRED_LIVE_LLM_TWO_STEP=true
# true = the call that writes those notes reasons first (minutes for an hour of meeting,
# against seconds; the notes come out a little shorter). Every other call follows
# FRED_LIVE_LLM_DISABLE_THINKING.
FRED_LIVE_LLM_NOTES_THINKING=false
# Required for Qwen3-family reasoning models served by llama.cpp or vLLM (which
# otherwise burn all max_tokens on thinking and return empty content). It sends
# chat_template_kwargs, which hosted APIs refuse: set false for those.
FRED_LIVE_LLM_DISABLE_THINKING=true

# --- llama-server launch knobs ---
# Read by scripts/run_llama_server.sh from its own environment; the example
# unit deploy/systemd/fred-llama.service loads them from this file.
#FRED_LIVE_LLAMACPP_BIN=<checkout>/vendor/llama.cpp/build/bin/llama-server
FRED_LIVE_LLAMACPP_PORT=18081
# Loopback by default. Bind anything wider only together with an API key file
# (one key per line; clients send "Authorization: Bearer <key>"). The script
# refuses to start when the file is configured but missing.
FRED_LIVE_LLAMACPP_HOST=127.0.0.1
#FRED_LIVE_LLAMACPP_API_KEY_FILE=<checkout>/data/credentials/llama_api_key
# Total context; with a fixed slot count it is split across slots, so keep
# CTX_SIZE / PARALLEL equal to FRED_LIVE_LLM_CTX_SIZE.
FRED_LIVE_LLAMACPP_CTX_SIZE=65536
FRED_LIVE_LLAMACPP_GPU_LAYERS=999
FRED_LIVE_LLAMACPP_PARALLEL=1
# 0 = disable thinking server-side, for models whose chat template thinks by
# default and ignores the per-request flag (Gemma 4). Leave unset for Qwen.
#FRED_LIVE_LLAMACPP_REASONING_BUDGET=0
# Speculative decoding via the model's official MTP drafter (bit-identical
# output, ~3x generation speed measured on a GB10). Auto-enabled when the
# default drafter file exists next to the model; set DRAFT_GGUF empty to disable.
# A drafter belongs to ONE model family: change it together with the model.
# FRED_LIVE_LLAMACPP_DRAFT_GGUF=<checkout>/models/unsloth__Qwen3.8-27B-GGUF/MTP/mtp-Qwen3.8-27B-Q4_0.gguf
# FRED_LIVE_LLAMACPP_SPEC_TYPE=draft-mtp
# FRED_LIVE_LLAMACPP_SPEC_DRAFT_MAX=4

# --- recording resolution ---
FRED_LIVE_PREFER_LOCAL_RECORDINGS=true
# Wait this long for the finalized master.webm before processing (the first of
# Vexa's two completion hooks points at an unfinished chunk).
FRED_LIVE_RECORDING_SETTLE_SECONDS=120
# Skip ASR/LLM when the recording has less speech-energy audio than this
# (bot-alone meetings record digital silence Whisper hallucinates on); such
# runs get quality="no_speech". 0 disables the guard.
FRED_LIVE_MIN_ACTIVE_SPEECH_SECONDS=5

# --- Vexa webhook + API ---
# REQUIRED. Shared secret for /internal/* endpoints (header X-Fred-Live-Token
# or ?token=...). The worker binds 0.0.0.0, so this is the LAN's only gate and
# is fail-CLOSED: empty/unset -> the worker returns 503 for every /internal/*
# request. Generate with: openssl rand -hex 24
# Must match the ?token= appended to the per-user webhook URL in vendor/vexa.
FRED_LIVE_AUTH_TOKEN=
# Vexa per-user webhook HMAC secret (registered via PUT /user/webhook). When
# set, meeting-completed posts REQUIRE a valid, fresh X-Webhook-Signature.
FRED_LIVE_WEBHOOK_SECRET=
# Optional fallback when the worker cannot resolve the local recording path.
# Must be a user-scoped Vexa API key because /recordings uses X-API-Key.
VEXA_API_BASE_URL=http://localhost:8056
VEXA_API_KEY=
VEXA_TIMEOUT_SECONDS=120

# --- calendar auto-join (scripts/run_autojoin.sh) ---
# One-time setup: python -m fred_live_worker.gcal_auth --client-secret <oauth.json>
# (calendars are normally connected per-user in the web UI instead).
FRED_LIVE_GCAL_CREDENTIALS=
FRED_LIVE_AUTOJOIN_LEAD_SECONDS=90
FRED_LIVE_AUTOJOIN_POLL_SECONDS=60
# Shown only on anonymous joins: an authenticated Meet bot appears under its
# Google account's own profile name.
FRED_LIVE_AUTOJOIN_BOT_NAME="Aplec Notetaker"
# How long past the scheduled start the bot waits for the first human
# (Vexa's own default of 120s is shorter than the join lead).
FRED_LIVE_AUTOJOIN_NO_SHOW_GRACE_SECONDS=600
# How long the bot stays once everyone else has left (guests can't "end for
# everyone", so this ends the meeting; Vexa default is 15 min of lingering).
FRED_LIVE_AUTOJOIN_ALONE_TIMEOUT_SECONDS=180
# Bot Google account (authenticated joins + auto-invite to calendar events
# removes the "possibly risky" label; requires the one-time browser_session login).
FRED_LIVE_BOT_GOOGLE_ACCOUNT=
FRED_LIVE_AUTOJOIN_AUTHENTICATED=true
FRED_LIVE_AUTOJOIN_INVITE_BOT=true

# --- retention ---
# Delete meeting AUDIO older than this many days (0 = off); transcripts and
# summaries are never touched. Runs through the meeting-api container
# (recordings are written as uid 999).
FRED_LIVE_RETENTION_DAYS=15
FRED_LIVE_RETENTION_CONTAINER=vexa-meeting-api-1

# Every 6h, look for audio on disk that produced NO run at all (a capture whose
# queued processing died with the worker; a webhook Vexa could not deliver).
# Captures still carry their metadata, so those are reprocessed automatically
# (once each, max 3 per sweep, nothing older than 3 days); bot recordings can
# only be reported, since the undelivered payload held the meeting identity.
# Findings land in data/orphaned_recordings.json; read-only listing:
#   python -m fred_live_worker.orphan_recordings
FRED_LIVE_ORPHAN_SWEEP_ENABLED=true
# Must exceed the longest normal ASR+LLM run, so a meeting being processed
# right now is never mistaken for one nobody knows about.
FRED_LIVE_ORPHAN_MIN_AGE_MINUTES=120

# --- fred_live_web frontend (scripts/run_web.sh; port 18091) ---
FRED_LIVE_WEB_HOST=127.0.0.1
FRED_LIVE_WEB_PORT=18091
# REQUIRED. Signs web sessions AND extension capture tokens. Fail-closed: the
# web app refuses to boot without it. Generate with: openssl rand -hex 32
FRED_LIVE_WEB_SESSION_SECRET=
FRED_LIVE_WEB_SESSION_MAX_AGE=1209600
# Allowlist AND identity map: "email:vexa_user_id[:admin]", comma-separated.
# Admins see every meeting; other users only their own. Also re-checked by the
# worker on every extension capture, so removing an email revokes that user's
# long-lived capture token, not just their web session.
FRED_LIVE_WEB_USERS=
# Hard ceiling on one extension capture's total uploaded audio (MB, 0 = off).
FRED_LIVE_CAPTURE_MAX_SESSION_MB=2048
# Extension captures of the same meet code by the same user within this many
# minutes resume the SAME meeting (multi-part); a recurring meeting reusing its
# link next day stays separate. 0 disables.
FRED_LIVE_CAPTURE_RESUME_GAP_MINUTES=30
# Dev login button (pre-OAuth). Only active while GOOGLE_OAUTH_CLIENT_ID is
# unset AND the app is bound to loopback (use an SSH tunnel to reach it).
FRED_LIVE_WEB_DEV_USER=
FRED_LIVE_WORKER_URL=http://127.0.0.1:18088
# Google OAuth WEB client (Cloud Console); redirect URI must be
# <FRED_LIVE_WEB_BASE_URL>/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FRED_LIVE_WEB_BASE_URL=http://localhost:18091
# Chrome Web Store listing (unlisted). Once the extension is approved, set the
# store URL here and Settings will hand it out (auto-updating installs) with
# the zip demoted to a dev fallback.
#FRED_LIVE_EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/<item-id>
