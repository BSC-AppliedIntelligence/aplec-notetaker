# Keep the build context tiny and secrets/state out of images. The web image
# (Dockerfile.web) COPYs only requirements.web.txt, aplec_web/ and two
# worker modules, but this file protects any future COPY-with-globs too.
.git
.venv
vendor
models
recordings
data
scratchpad
node_modules
__pycache__
*.pyc
.env.worker
.env.pre-update-backup
