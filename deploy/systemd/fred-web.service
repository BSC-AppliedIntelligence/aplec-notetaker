# Copy to ~/.config/systemd/user/ (docs/INSTALL.md, section 8). Assumes the
# checkout at ~/fred-notetaker: change the three paths if it is elsewhere.
[Unit]
Description=Fred web app
After=fred-worker.service

[Service]
WorkingDirectory=%h/fred-notetaker
EnvironmentFile=%h/fred-notetaker/.env.worker
ExecStart=%h/fred-notetaker/scripts/run_web.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
