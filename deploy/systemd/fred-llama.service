# The local summarizer (docs/INSTALL.md, section 5, option A). Copy to
# ~/.config/systemd/user/. scripts/run_llama_server.sh takes its settings
# (FRED_LIVE_LLAMACPP_*) from the environment, loaded here from .env.worker.
[Unit]
Description=Fred summarizer (llama.cpp server)

[Service]
WorkingDirectory=%h/fred-notetaker
EnvironmentFile=%h/fred-notetaker/.env.worker
ExecStart=%h/fred-notetaker/scripts/run_llama_server.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
